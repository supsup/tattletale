# tattletale settings. Copy this file to tattletale.env (next to tattletale.py) and edit.
# tattletale.env is git-ignored, so your own values are never committed.
#
# Every setting can also be given as an environment variable of the same name, or as a
# command-line flag (TATTLETALE_KEEP_LOGS=5 is --keep-logs 5). Priority, highest first:
#   command-line flag  >  environment variable  >  this file  >  built-in default
# Run `python3 tattletale.py --show-settings` to see the effective value of each and where
# it came from. Lines are KEY=VALUE; values are taken literally (no shell expansion,
# except a leading ~ in paths).

# Where the database and the log live. The page data file (tattletale-data.js) and the
# startup-snapshots/ folder are written next to the database. Default: next to tattletale.py.
# TATTLETALE_DB=~/tattletale/tattletale.db
# TATTLETALE_LOG=~/tattletale/tattletale.log
# TATTLETALE_MAP is only read once, to import a JSON map from an older version.
# TATTLETALE_MAP=~/tattletale/tattletale-map.json

# How long to keep history, in days (0 keeps it forever). Sightings (one row per new
# process instance) are by far the busiest table, so they have their own, shorter window.
# Programs, listeners and startup items are always kept.
# TATTLETALE_RETENTION_DAYS=30
# TATTLETALE_SIGHTINGS_RETENTION_DAYS=7

# How often each check runs, in seconds.
# TATTLETALE_PROCESS_INTERVAL=3
# TATTLETALE_LISTEN_INTERVAL=30
# TATTLETALE_STARTUP_INTERVAL=300

# macOS notifications for alerts (credential prompts, newly exposed ports, startup changes,
# new unsigned programs). At most one per kind per minute. true or false.
# TATTLETALE_NOTIFY=true

# Log rotation: rotate at this size, keep this many old logs (tattletale.log.1, .2, ...).
# TATTLETALE_ROTATE_MB=20
# TATTLETALE_KEEP_LOGS=3

# Extra files to watch as startup items, colon-separated.
# TATTLETALE_EXTRA_STARTUP=~/.config/starship.toml:~/.ssh/config
